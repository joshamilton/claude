config {
    testsDir   = "."
    workDir    = System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile = "tests/nextflow.config"

    // Tests are always invoked by explicit path (scripts/test.sh); no discovery ignore list.
    // Pipeline integration: +local activates Docker from nextflow.config.

    triggers = [
        'conf/test.config',
        'modules.json',
        'nextflow.config',
        'nf-test.config',
        'tests/nextflow.config',
    ]

    plugins {
        load "nft-utils@0.0.9"
    }
}
