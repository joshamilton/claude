/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    [project-name] Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = '[manifest-name]'
    author          = '[author]'
    contributors    = [
        [
            name: '[author]',
            affiliation: '',
            email: '',
            github: '',
            contribution: [],
            orcid: ''
        ],
    ]
    homePage        = '[github-url]'
    description     = '[pipeline-description]'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0'
    doi             = ''
}

plugins {
    id 'nf-schema@2.5.1'
}

params {

    input = null
    // Add pipeline-specific params here (for example reference_database = null)

    // Cloud options: paste the "params" block from "Pipeline settings" in aws.md or gcp.md.

    // MultiQC options: keep only if the pipeline runs MultiQC.
    multiqc_config         = null
    multiqc_title          = null
    multiqc_logo           = null
    max_multiqc_email_size = '25.MB'

    outdir              = null
    publish_dir_mode    = 'copy'
    monochrome_logs     = false
    help                = false
    help_full           = false
    show_hidden         = false
    version             = false
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    validate_params     = true
}

outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

validation {
    defaultIgnoreParams = [
        'input',
        // Pipeline-specific params
        // Cloud params: paste the entries from "Pipeline settings" in aws.md or gcp.md
        'multiqc_title',            // MultiQC entries: keep only if the pipeline runs MultiQC
        'max_multiqc_email_size',
        'multiqc_config',
        'multiqc_logo',
        'validate_params',
        'help_full',
        'show_hidden',
    ]
    monochromeLogs = params.monochrome_logs
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    local {
        docker {
            enabled    = true
            runOptions = '-u $(id -u):$(id -g)'
        }
        process {
            executor = 'local'
            arch     = 'amd64'       // Container strategy A only
        }
        workDir = "/tmp/nextflow-work-${System.getenv('USER')}"
        // Container strategy A: paste the two includeConfig statements from "Wiring" in containers.md.
        // AWS: paste the "aws" block for the local profile from "Pipeline settings" in aws.md.
    }

    // Cloud profile: paste the profile from "Pipeline settings" in aws.md or gcp.md.

    // Keep the test profile only if the pipeline has the development tooling.
    test { includeConfig 'conf/test.config' }
}

docker.registry = 'quay.io'

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

process.shell = [
    "bash",
    "-C",
    "-e",
    "-u",
    "-o",
    "pipefail"
]

nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/logs/${params.trace_report_suffix}/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/logs/${params.trace_report_suffix}/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/logs/${params.trace_report_suffix}/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/logs/${params.trace_report_suffix}/pipeline_dag_${params.trace_report_suffix}.html"
}
